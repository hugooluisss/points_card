DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_DATABASE=points_card
DB_DATABASE_TEST=points_card_test
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
TRUST_PROXY=loopback
# Caddy forwards X-Forwarded-For; behind Cloudflare it uses CF-Connecting-IP and adds X-Forwarded-For.
# Shared-host deployment: set AUTH_COOKIE_PATH=/points-card-api/auth. The default is /.
AUTH_COOKIE_PATH=/
BUSINESS_TIMEZONE=America/Mexico_City
PUBLIC_WEB_URL=https://agents-dev.hugosantiago.dev/points-card-app
RECOVERY_NOTIFIER=simulated
WALLET_PASS_PROVIDER=simulated
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_KEY_PATH=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_RETURN_URL=
BILLING_GRACE_DAYS=7
BILLING_RETENTION_DAYS=90
BILLING_RECONCILIATION_CRON=0 3 * * *
